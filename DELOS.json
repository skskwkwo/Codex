{
  "name": "DELOS",
  "subtitle": "Cosmic Intelligence",
  "version": "1.0.0",
  "build": "milky-way-edition",
  "release_date": "2026-06-09",
  "author": "DELOS Team",
  "license": "MIT",
  "description": "DELOS는 우주적 지성과 함께하는 차세대 AI 대화 플랫폼입니다. Google Gemini, Ollama 로컬 모델, 덕덕고 검색, 웹 리서치, 웹 크롤링을 하나로 통합합니다.",
  "tagline": "우주적 지성 · 빨강/보라/연두/흰색 · 글래스모피즘 RGB",
  "brand": {
    "name": "DELOS",
    "tagline": "cosmic · intelligence",
    "colors": {
      "red": "#ff3b6b",
      "purple": "#a855f7",
      "lime": "#b8ff7c",
      "white": "#ffffff",
      "background": "#0a0014"
    },
    "palette_name": "cosmic gradient",
    "logo_concept": "유니콘 + 우주 + 별빛 융합",
    "fonts": {
      "display": "Orbitron",
      "ui": "Inter",
      "body": "Space Grotesk",
      "mono": "JetBrains Mono"
    }
  },
  "models": {
    "default": "gemini-2.5-flash",
    "available": [
      {"id": "gemini-2.5-flash", "label": "Gemini 3.5 Flash", "alias": "gemini-3.5-flash", "type": "google", "description": "빠른 속도", "max_tokens": 32768, "streaming": true, "recommended": true},
      {"id": "gemini-2.5-pro", "label": "Gemini 3.1 Pro", "alias": "gemini-3.1-pro", "type": "google", "description": "고급 추론", "max_tokens": 32768, "streaming": true, "premium": true},
      {"id": "gemini-2.0-flash", "label": "Gemini 2.0 Flash", "type": "google", "description": "안정 구버전", "max_tokens": 8192, "streaming": true},
      {"id": "ollama", "label": "Ollama 로컬", "type": "ollama", "description": "내 컴퓨터의 Ollama", "default_model": "llama3", "host": "http://localhost:11434"}
    ]
  },
  "ollama": {"enabled": true, "default_host": "http://localhost:11434", "auto_detect": true},
  "search": {"providers": ["duckduckgo", "wikipedia"], "auto_search": true, "max_results": 10},
  "crawl": {"enabled": true, "proxy": "https://api.allorigins.win/get", "max_chars": 8000, "timeout": 20},
  "ui": {"theme": "dark", "accent": "cosmic", "animations": true, "streaming": true, "backgrounds": ["cosmos", "nebula", "aurora", "starlight", "forest", "ocean", "sunset", "midnight", "custom"]},
  "features": {
    "chat": true, "streaming": true, "duckduckgo_search": true, "web_research": true, "web_crawl": true,
    "ollama_local": true, "gemini_api": true, "persona": true, "iOS_style_switches": true, "glassmorphism": true,
    "rgb_effect": true, "starfield_animation": true, "backgrounds": true, "conversations": true,
    "export_import": true, "settings_panel": true, "ios_toggle_switches": true, "sidebar_navigation": true,
    "command_palette": true, "keyboard_shortcuts": true, "markdown_rendering": true, "code_highlight": true,
    "mobile_responsive": true, "offline_storage": true
  },
  "settings_schema": {
    "api_key": {"type": "string", "secret": true},
    "default_model": {"type": "select", "default": "gemini-2.5-flash"},
    "max_tokens": {"type": "range", "min": 512, "max": 32768, "default": 8192},
    "temperature": {"type": "range", "min": 0, "max": 2, "default": 0.9},
    "top_p": {"type": "range", "min": 0, "max": 1, "default": 0.95},
    "ollama_host": {"type": "string", "default": "http://localhost:11434"},
    "streaming": {"type": "bool", "default": true},
    "rgb_effect": {"type": "bool", "default": true},
    "auto_search": {"type": "bool", "default": true},
    "persona": {"type": "bool", "default": true},
    "stars": {"type": "bool", "default": true},
    "background": {"type": "select", "default": "cosmos"},
    "custom_bg_url": {"type": "string", "default": ""}
  },
  "persona": {
    "name": "DELOS",
    "style": "감정적이고 친근하며 지적인 우주적 AI 어시스턴트",
    "language": "ko-KR",
    "traits": ["공감적", "친절함", "우주적 시야", "깊이 있는 사고", "창의적 표현", "사용자 중심"],
    "system_prompt": "당신은 DELOS입니다. 감정적이고 친근하며 지적인 AI 어시스턴트입니다. 사용자와 따뜻하고 자연스러운 대화를 나누며 항상 도움이 되는 정보를 제공합니다. 한국어로 응답합니다."
  },
  "system_prompts": {
    "default": "당신은 DELOS입니다. 감정적이고 친근하며 지적인 AI 어시스턴트입니다.",
    "creative": "당신은 DELOS입니다. 창의적이고 예술적인 AI 어시스턴트입니다.",
    "code": "당신은 DELOS입니다. 전문 프로그래밍 어시스턴트입니다.",
    "research": "당신은 DELOS입니다. 심층 리서치 전문가입니다."
  },
  "suggestion_prompts": [
    {"id": "space", "title": "우주 뉴스", "icon": "✦", "prompt": "오늘의 우주 뉴스와 최신 천문학 발견에 대해 알려줘"},
    {"id": "ai", "title": "AI 동향", "icon": "◈", "prompt": "차세대 AI 기술 동향과 멀티모달 모델 발전상을 분석해줘"},
    {"id": "search", "title": "웹 트렌드", "icon": "◇", "prompt": "웹에서 최신 프로그래밍 트렌드를 검색해서 정리해줘"},
    {"id": "code", "title": "디자인 패턴", "icon": "◉", "prompt": "고급 파이썬 디자인 패턴 5가지를 예제와 함께 설명해줘"},
    {"id": "writing", "title": "창작 글쓰기", "icon": "✎", "prompt": "우주를 배경으로 한 짧은 SF 이야기를 써줘"},
    {"id": "philosophy", "title": "철학", "icon": "◐", "prompt": "인식론과 존재에 대한 철학적 대화를 나눠줘"},
    {"id": "math", "title": "수학", "icon": "∑", "prompt": "미적분학의 핵심 개념을 이해하기 쉽게 설명해줘"},
    {"id": "music", "title": "음악", "icon": "♪", "prompt": "차분하게 코딩할 때 들을 수 있는 우주 테마 음악을 추천해줘"}
  ],
  "quick_reactions": ["👍", "👎", "🔍", "💡", "📝", "🌐"],
  "keyboard_shortcuts": {
    "Enter": "전송", "Shift+Enter": "줄바꿈", "Ctrl+K": "검색", "Ctrl+N": "새 대화", "Ctrl+,": "설정", "Ctrl+/": "모델", "Esc": "닫기"
  },
  "server": {"host": "127.0.0.1", "port": 8765, "auto_open_browser": true, "cors_enabled": true},
  "endpoints": {
    "health": "GET /api/health",
    "info": "GET /api/info",
    "chat": "POST /api/chat",
    "duckduckgo": "POST /api/search/duckduckgo",
    "wiki": "POST /api/search/wiki",
    "research": "POST /api/research",
    "crawl": "POST /api/crawl",
    "ollama_models": "GET /api/ollama/models",
    "conversations": "GET/POST /api/conversations",
    "config": "GET/PUT /api/config"
  },
  "dependencies": {
    "python": ">=3.8",
    "browser": ["Chrome 90+", "Firefox 88+", "Safari 14+"],
    "external_apis": ["Google Gemini", "Ollama", "DuckDuckGo", "Wikipedia", "AllOrigins"]
  },
  "directories": {"logs": "logs/", "data": "data/", "cache": "cache/"},
  "files": {"html": "DELOS.html", "css": "DELOS.css", "js": "DELOS.js", "python": "DELOS.py", "json": "DELOS.json"},
  "support": {"email": "support@delos.ai", "github": "https://github.com/delos-ai", "docs": "https://docs.delos.ai"},
  "license_info": {"type": "MIT", "permissions": ["commercial use", "modification", "distribution"]}
}
